{
  "name": "crest",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "bridge": "cargo build -p atoll-bridge",
    "bridge:release": "cargo build -p atoll-bridge --release",
    "app": "npm run bridge && tauri dev",
    "app:release": "npm run bridge:release && tauri build --no-bundle",
    "installer": "tauri build && node scripts/prune-installers.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "glisse": "0.5.0",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "svelte": "5.57.3",
    "vite": "8.3.6"
  }
}
